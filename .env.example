# Database (Vercel -> Storage -> Neon sets DATABASE_URL for you)
DATABASE_URL=
# Gemini
GEMINI_API_KEY=
# Dashboard login (password for now): pick a long one
APP_PASSWORD=
# Random 32+ char string used to sign the login cookie
SESSION_SECRET=
# Random string; Vercel cron sends it as a Bearer token automatically
CRON_SECRET=
# Random string; the local Outlook sender uses it
SENDER_TOKEN=
